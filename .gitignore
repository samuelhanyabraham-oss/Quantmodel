# Raw pulls and snapshots ARE committed: the container is ephemeral and the
# data source (IBKR MCP) is session-bound, so the repo itself must carry the
# frozen data for any result to be reproducible. Hashes live in
# data/HOLDOUT_MANIFEST.json.
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
